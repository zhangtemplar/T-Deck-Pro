// ---- Default location for Weather when GPS is unavailable ----
// Format: "lat=XX.XX&lon=YY.YY" (use https://www.latlong.net to find coordinates)
// #define WEATHER_DEFAULT_COORDS  "lat=37.49&lon=-122.27"

